<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.VOD</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the server provides these assemblies. PluginManager loads every *.dll it
         finds in the plugin folder into the plugin's own load context, so a shipped copy of
         MediaBrowser.Controller would sit beside the server's, and an ILibraryManager the plugin
         asks for would no longer be the type the server's DI hands out. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Ships the managed SQLite assemblies but not the native library. Native code is always
         resolved from the server, because PluginLoadContext overrides Load but not
         LoadUnmanagedDll. Worse than useless, too: PluginManager's *.dll scan is recursive, so
         runtimes/win-*/native/e_sqlite3.dll would be loaded as a managed assembly, fail, and mark
         the plugin Malfunctioned on every platform. Pinned at the version Microsoft.Data.Sqlite
         pulls transitively. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" ExcludeAssets="native" />
    <!-- Compile-time only: the server already loads SkiaSharp and its native library from
         /jellyfin, so shipping our own copy would duplicate it and risk two versions in one
         process. "runtime" keeps the managed assembly out of the published plugin; "native" is
         needed too, or the publish output still carries the win-x64, win-x86, win-arm64 and osx
         copies of libSkiaSharp — 40 MB of payload the plugin never loads. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jellyfin.Plugin.VOD.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
  </ItemGroup>

</Project>
